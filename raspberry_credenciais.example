# Exemplo de arquivo de credenciais SSH para o Raspberry Pi.
# Copie para raspberry_credenciais (sem .example) e preencha — esse arquivo
# é ignorado pelo git (.gitignore) e nunca deve ser commitado.
#
# Uso com deploy.sh:
#   RETROHOST_PI_USER=pi RETROHOST_PI_HOST=192.168.1.x ./scripts/deploy.sh
#
# Alternativamente, configure autenticação por chave SSH:
#   ssh-copy-id pi@192.168.1.x
# e não precisará de senha em nenhum script.

PI_HOST=192.168.1.x
PI_USER=pi
