[Unit]
Description=RetroHost - mediamtx (servidor WebRTC/WHEP de streaming)
After=network.target

[Service]
Type=simple
User=YOUR_USER
WorkingDirectory=/home/YOUR_USER/retrohost
ExecStart=/home/YOUR_USER/retrohost/bin/mediamtx /home/YOUR_USER/retrohost/config/mediamtx.yml
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
