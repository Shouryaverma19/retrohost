[Unit]
Description=RetroHost - servidor de jogos retro
After=network.target mediamtx.service
Wants=mediamtx.service

[Service]
Type=simple
User=YOUR_USER
WorkingDirectory=/home/YOUR_USER/retrohost/backend
Environment=HOMEGAMES_ROOT=/home/YOUR_USER/retrohost
ExecStart=/home/YOUR_USER/retrohost/backend/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
